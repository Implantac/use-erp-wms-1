# ============================================================
# USE ERP — variáveis do frontend (copie para .env)
# Detalhes de cada variável: docs/ENVIRONMENT.md
# ============================================================

# URL do SEU projeto Supabase (Settings > API > Project URL). Obrigatória.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "anon" do SEU projeto (Settings > API). Obrigatória. Pública por natureza.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ID (ref) do SEU projeto Supabase — o subdomínio da URL acima. Obrigatória.
VITE_SUPABASE_PROJECT_ID=

# ------------------------------------------------------------
# Usadas apenas pelo `npm run setup` (nunca vão para o navegador)
# ------------------------------------------------------------

# String de conexão Postgres do SEU projeto (Settings > Database > Connection string, modo "Session").
# Necessária somente para aplicar migrations via setup. Opcional se usar `supabase db push`.
DATABASE_URL=
