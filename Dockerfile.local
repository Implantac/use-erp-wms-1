# USE ERP — frontend para instalação LOCAL (Docker, Windows/Linux/macOS).
# Igual ao build de produção, mas SEM variáveis da nuvem: a URL/chave do
# Supabase local são resolvidas em tempo de execução (ver /config.js e
# src/integrations/supabase/config.ts), então o mesmo build serve em
# localhost e pelo IP da rede local.
FROM oven/bun:1.4.2 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
# Valores vazios de propósito — nunca embutir a nuvem no build local.
ENV VITE_SUPABASE_URL="" \
    VITE_SUPABASE_PUBLISHABLE_KEY="" \
    VITE_SUPABASE_PROJECT_ID="" \
    NODE_OPTIONS="--max-old-space-size=4096"
RUN bun run build

FROM nginx:1.27-alpine
COPY docker/local/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/local/web/40-useerp-config.sh /docker-entrypoint.d/40-useerp-config.sh
RUN chmod +x /docker-entrypoint.d/40-useerp-config.sh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK CMD wget -qO- http://127.0.0.1/healthz || exit 1
