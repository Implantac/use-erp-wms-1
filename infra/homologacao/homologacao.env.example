# ============================================================================
# MODELO — copiar para /home/user/use-erp-implementation/.env.homologacao
# (nome com ponto inicial: ignorado por .gitignore e .dockerignore).
# NAO versionar o arquivo preenchido. NAO colar valores no chat.
#
# Os 18 primeiros nomes sao EXATAMENTE os exigidos pelo step
# "Validate isolated E2E configuration" de .github/workflows/e2e.yml.
# O pre-voo `node scripts/validate-homologacao-env.mjs` reprova todos os
# placeholders abaixo: eles existem so para mostrar o que preencher.
# ============================================================================

# --- 18 segredos do gate autenticado ---------------------------------------
VITE_SUPABASE_URL=<URL_LOOPBACK_DO_WEB>
VITE_SUPABASE_PUBLISHABLE_KEY=<ANON_KEY_GERADA_LOCALMENTE>
E2E_TENANT_A_EMAIL=<EMAIL_DO_TENANT_A_DA_MASSA>
E2E_TENANT_A_PASSWORD=<SENHA_DO_TENANT_A_DA_MASSA>
E2E_TENANT_B_EMAIL=<EMAIL_DO_TENANT_B_DA_MASSA>
E2E_TENANT_B_PASSWORD=<SENHA_DO_TENANT_B_DA_MASSA>
E2E_STORE_EMAIL=<EMAIL_DO_OPERADOR_DE_LOJA>
E2E_STORE_PASSWORD=<SENHA_DO_OPERADOR_DE_LOJA>
E2E_MANAGER_EMAIL=<EMAIL_DO_GESTOR>
E2E_MANAGER_PASSWORD=<SENHA_DO_GESTOR>
E2E_PRODUCT_ID=<UUID_DESCOBERTO_POR_CODIGO>
E2E_STORE_BRANCH_ID=<UUID_DA_FILIAL_LOJA>
E2E_CD_BRANCH_ID=<UUID_DA_FILIAL_CD>
E2E_WEAVING_EMAIL=<EMAIL_DO_OPERADOR_PCP>
E2E_WEAVING_PASSWORD=<SENHA_DO_OPERADOR_PCP>
E2E_WEAVING_PRODUCT_ID=<UUID_DO_PRODUTO_ACABADO>
E2E_WEAVING_COMPONENT_ID=<UUID_DO_INSUMO>
E2E_WEAVING_LOT_ID=<UUID_DO_LOTE_DE_ENTRADA>

# --- Variaveis tecnicas da stack (generate-env.mjs preenche) ---------------
WEB_PORT=8080
SUPABASE_PUBLIC_URL=http://localhost:8080
SITE_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080
ADDITIONAL_REDIRECT_URLS=http://localhost:8080/**,http://127.0.0.1:8080/**
POSTGRES_PASSWORD=<GERAR_VIA_generate-env.mjs>
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
JWT_SECRET=<GERAR_VIA_generate-env.mjs>
ANON_KEY=<GERAR_VIA_generate-env.mjs>
SERVICE_ROLE_KEY=<GERAR_VIA_generate-env.mjs>
JWT_EXPIRY=3600
SECRET_KEY_BASE=<GERAR_VIA_generate-env.mjs>
REALTIME_DB_ENC_KEY=<GERAR_VIA_generate-env.mjs>
PG_META_CRYPTO_KEY=<GERAR_VIA_generate-env.mjs>
CRON_SECRET=<GERAR_VIA_generate-env.mjs>

# --- Massa deterministica (senhas de FIXTURE, nao credenciais reais) -------
E2E_ADMIN_EMAIL=<EMAIL_DO_ADMIN_DOS_SEEDS>
E2E_ADMIN_PASSWORD=<SENHA_DO_ADMIN_DOS_SEEDS>

# NUNCA preencher aqui: service_role de producao, DATABASE_URL de producao,
# tokens de acesso pessoal, chaves de PSP/SEFAZ ou dados de cliente.
