# ============================================================================
# USE ERP — referência das variáveis da instalação LOCAL (Docker).
# NÃO use este arquivo direto: rode o instalador, que gera um `.env.local`
# com segredos novos para a sua máquina:
#   Windows:  .\instalar-local.ps1
#   Manual:   node docker/local/scripts/generate-env.mjs
# Este exemplo existe só para documentar cada variável.
# ============================================================================

# Porta do sistema no navegador (http://localhost:8080 ou http://<IP>:8080)
WEB_PORT=8080
# URL pública desta instalação (troque localhost pelo IP da máquina na rede local)
SUPABASE_PUBLIC_URL=http://localhost:8080
SITE_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080
ADDITIONAL_REDIRECT_URLS=http://localhost:8080/**,http://127.0.0.1:8080/**

# PostgreSQL local
POSTGRES_PASSWORD=gerado-pelo-instalador
# (o superusuario interno da imagem e supabase_admin; nao e preciso definir)
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Segredos gerados pelo instalador (JWT_SECRET assina ANON_KEY/SERVICE_ROLE_KEY)
JWT_SECRET=gerado-pelo-instalador
ANON_KEY=gerado-pelo-instalador
SERVICE_ROLE_KEY=gerado-pelo-instalador
JWT_EXPIRY=3600
SECRET_KEY_BASE=gerado-pelo-instalador
REALTIME_DB_ENC_KEY=gerado-pelo-instalador
VAULT_ENC_KEY=gerado-pelo-instalador
PG_META_CRYPTO_KEY=gerado-pelo-instalador
S3_PROTOCOL_ACCESS_KEY_ID=gerado-pelo-instalador
S3_PROTOCOL_ACCESS_KEY_SECRET=gerado-pelo-instalador
CRON_SECRET=gerado-pelo-instalador

# Sem servidor de e-mail local, o cadastro já nasce confirmado.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=USE ERP Local

# Painel do banco opcional (perfil studio, http://localhost:3000)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=gerado-pelo-instalador

# Opcionais — vazio = 100% offline (a função responde indisponível)
LOVABLE_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
INCIDENT_EMAIL_FROM=
COMMERCE_NOTIFY_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PSP_WEBHOOK_SECRET=
PIX_WEBHOOK_SECRET=
# NÃO ligue em produção: 'true' habilita simulação de pagamento Pix (só homologação)
PIX_SIMULATION_ENABLED=
SEFAZ_MTLS_PROXY_URL=
SEFAZ_MTLS_PROXY_TOKEN=
SEFAZ_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=
BRAIN_WEBHOOK_URL=
RFID_WEBHOOK_API_KEY=
RFID_WEBHOOK_SECRET=
REINF_WS_ENDPOINT=
ALLOWED_ORIGINS=
# (detalhes em docs/INSTALL-LOCAL.md, seção 5)
